<?xml version="1.0" encoding="utf-8"?>
<!--
  TOTALplayer para móviles y tabletas.

  A diferencia de la de televisión, esta sí lleva el LAUNCHER normal —es la que
  aparece en el cajón de aplicaciones del teléfono— y gira con el aparato: el
  vídeo se ve tumbado y el resto de la aplicación, de pie.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.totalplayer.movil">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Un móvil sí tiene pantalla táctil, pero la app vale igual en una
         tableta o en un Chromebook: no se exige nada que deje aparatos fuera -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Tema"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/red"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:hardwareAccelerated="true"
            android:screenOrientation="fullUser"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
