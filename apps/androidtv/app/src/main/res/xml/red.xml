<?xml version="1.0" encoding="utf-8"?>
<!--
  Solo 127.0.0.1 puede ir sin cifrar, y por una razón concreta.

  Lo que está descargado en el aparato se le sirve al WebView desde un
  servidor de bucle local (ver ServidorLocal.java): es la única forma de que
  un vídeo guardado se pueda avanzar y retroceder desde una página en https.
  Ese tráfico no sale del aparato. Todo lo demás sigue exigiendo https, que
  es lo que dice `cleartextTrafficPermitted="false"` de abajo.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
