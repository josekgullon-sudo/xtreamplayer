<?xml version="1.0" encoding="utf-8"?>
<!--
  El reproductor nativo, para televisión y para teléfono.

  La misma aplicación sirve para los dos porque lo que las diferencia son
  las pantallas, no el motor: el acceso, el catálogo, los favoritos y la
  reproducción son idénticos. Los diseños de tele viven en
  res/layout-sw540dp y los de teléfono en res/layout, y la orientación la
  decide Pantalla según dónde se esté ejecutando.

  Y la razón de ser también vale para el teléfono: el envoltorio de WebView
  no puede con H.265 ni con AC3 en ninguna de las dos pantallas.

  Convive con apps/androidtv, que es el envoltorio de WebView: mientras esto
  no esté probado en un aparato de verdad, aquel sigue siendo el que se
  entrega. Los dos identificadores son distintos a propósito, para poder
  tener los dos instalados a la vez y compararlos en la misma tele.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Un televisor no tiene pantalla táctil: sin esto, Google Play no la
         ofrece a las teles y Amazon la rechaza -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@style/Tema"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:usesCleartextTraffic="true">

        <!-- Se entra por la presentación, no por el formulario -->
        <activity
            android:name=".ArranqueActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTask"
           
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AccesoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Las demás pantallas. Ninguna es exported: a esta aplicacion se
             entra por la puerta, no por un enlace de otra aplicacion -->
        <activity android:name=".PerfilesActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".InicioActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".DirectoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".PortadaActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".VodActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".FichaActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".BuscarActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".DescargasActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />
        <activity android:name=".ReproductorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

    </application>
</manifest>
