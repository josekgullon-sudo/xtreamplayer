<?xml version="1.0" encoding="utf-8"?>
<!-- «Añadir perfil»: hueco y de línea discontinua, como en la web -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/elevada" />
            <stroke android:width="4dp" android:color="@color/texto" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <stroke android:width="2dp" android:color="@color/borde"
                android:dashWidth="9dp" android:dashGap="7dp" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
