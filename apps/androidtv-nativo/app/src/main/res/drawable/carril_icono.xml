<?xml version="1.0" encoding="utf-8"?>
<!--
  La marca de «estás aquí» en el teléfono: la pastilla de DETRÁS del icono.
  La de la tele es una raya corta debajo y vive en drawable-sw540dp.

  Son dos dibujos y no uno porque el sitio cambia lo que puede ser el color.
  Detrás del icono, el blanco entero dejaba un icono blanco sobre una
  pastilla blanca: la sección abierta era la única que no se veía. Debajo
  del icono no estorba a nadie, y ahí sí va entero.

  Blanco y no rojo: el rojo es el color de lo que se pulsa, y usándolo
  además para decir dónde estás las dos señales se confunden. Misma
  decisión que en la web. El foco del mando lo pinta otra cosa
  (carril_item), porque son dos preguntas distintas.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/filo_fuerte" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
