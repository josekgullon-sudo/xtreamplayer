<?xml version="1.0" encoding="utf-8"?>
<!--
  La pastilla de detrás del icono: dice en qué sección ESTÁS, no dónde tienes
  el mando. Son dos cosas distintas y hay que poder verlas a la vez, así que
  el foco lo pinta el fondo del botón (carril_item) y esto solo se enciende
  para la sección abierta.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca_tinte" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tranquilo" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
