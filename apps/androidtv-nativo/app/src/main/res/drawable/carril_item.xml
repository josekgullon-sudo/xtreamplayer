<?xml version="1.0" encoding="utf-8"?>
<!--
  El fondo del destino del carril, con el foco del mando.

  Va aquí y no en la pastilla del icono: el que recibe el foco es el botón
  entero, y en Android el estado NO baja solo a los hijos. La pastilla tenía
  escrito qué hacer al enfocarse y no se enteraba nunca, así que moviendo el
  mando por el carril no se veía dónde estabas: se oía el cambio, se entraba
  con OK, y a ciegas.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/foco_relleno" />
            <stroke android:width="3dp" android:color="@color/foco" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
