<?xml version="1.0" encoding="utf-8"?>
<!-- .pa-rail del web: la columna de iconos pegada a la izquierda en la tele -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/columna" />
        </shape>
    </item>
    <item android:top="-2dp" android:bottom="-2dp" android:left="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/filo" />
        </shape>
    </item>
</layer-list>
