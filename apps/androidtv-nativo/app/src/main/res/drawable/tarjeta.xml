<?xml version="1.0" encoding="utf-8"?>
<!-- .feature-card del web: fondo un escalón por encima, filo fino y esquinas
     de 22. Enfocada sube otro escalón y se enmarca en rojo, como el
     outline del modo TV -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca_tinte_fuerte" />
            <stroke android:width="4dp" android:color="@color/marca_viva" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <stroke android:width="1dp" android:color="@color/filo" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
