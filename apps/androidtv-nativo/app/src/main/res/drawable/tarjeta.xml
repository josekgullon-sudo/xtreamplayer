<?xml version="1.0" encoding="utf-8"?>
<!--
  La tarjeta de sección.

  El foco lo marca el borde, no el relleno: con el relleno al 28% la tele lo
  saturaba hasta convertir la tarjeta enfocada en un bloque fucsia que se
  comía el texto. Ahora el fondo sube apenas, y quien grita es el borde.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/elevada" />
            <stroke android:width="4dp" android:color="@color/foco" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <stroke android:width="1dp" android:color="@color/filo" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
