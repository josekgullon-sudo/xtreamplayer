<?xml version="1.0" encoding="utf-8"?>
<!-- .btn-primary: pastilla roja. En el web los botones son de radio
     completo, no rectángulos con las esquinas limadas -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca_viva" />
            <stroke android:width="3dp" android:color="@color/marca_viva" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/marca" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
