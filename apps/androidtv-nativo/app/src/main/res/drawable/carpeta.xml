<?xml version="1.0" encoding="utf-8"?>
<!-- .pa-live-cat / .pa-live-chan. En modo TV el web enfoca con rojo diluido
     de fondo y borde de marca; la carpeta abierta se queda con el tinte
     suave para no perder de vista en qué lista estás -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca_tinte_fuerte" />
            <stroke android:width="3dp" android:color="@color/marca_viva" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca_tinte" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca_tinte" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item><color android:color="@android:color/transparent" /></item>
</selector>
