<?xml version="1.0" encoding="utf-8"?>
<!--
  El velo de abajo del destacado, y termina en el color del fondo.

  El velo de siempre acaba en un negro que no es el nuestro (#0B0A0F), y en
  una banda que corta a media pantalla eso se nota: queda una raya más clara
  justo donde se acaba la imagen. Este acaba exactamente en @color/fondo, así
  que no hay corte que ver.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#FF101012"
        android:centerColor="#C0101012"
        android:endColor="#00101012"
        android:type="linear" />
</shape>
