<?xml version="1.0" encoding="utf-8"?>
<!-- .input del web: fondo apenas levantado, filo fino, y al enfocar el rojo
     de la marca, que en una tele es la única referencia de dónde estás -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/elevada" />
            <stroke android:width="3dp" android:color="@color/foco" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tranquilo" />
            <stroke android:width="1dp" android:color="@color/filo" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
