<?xml version="1.0" encoding="utf-8"?>
<!-- .pa-card: la carátula ya es la información; sin foco, solo un filo -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/marca_tinte_fuerte" />
            <stroke android:width="4dp" android:color="@color/marca_viva" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <stroke android:width="1dp" android:color="@color/filo" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
