<?xml version="1.0" encoding="utf-8"?>
<!-- El marco del cartel: la carátula ya es la información, así que sin foco
     no hay borde que la ensucie -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/elevada" />
            <stroke android:width="3dp" android:color="@color/marca" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
