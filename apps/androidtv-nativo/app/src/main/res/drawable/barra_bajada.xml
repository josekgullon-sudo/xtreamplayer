<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo que lleva bajado, con los mismos valores que la web (.tv-bajada-barra):
  el carril en blanco al 16 % y lo hecho en el rojo de la marca, los dos
  con las puntas redondas.

  Sin esto salía la barra que trae Android con el tema de esta aplicación:
  cuadrada, del color que decida el fabricante y sin nada que ver con la
  fila donde va.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#29FFFFFF" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/marca" />
                <corners android:radius="999dp" />
            </shape>
        </clip>
    </item>
</layer-list>
