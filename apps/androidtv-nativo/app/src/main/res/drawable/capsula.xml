<?xml version="1.0" encoding="utf-8"?>
<!--
  .pa-bottomnav del web: la cápsula que flota abajo en el teléfono.

  Con esquinas de 999dp y separada de los tres bordes. Pegada al borde, en
  un móvil con gesto de inicio, el último botón cae justo donde el sistema
  pone su propia barra.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/elevada" />
    <stroke android:width="1dp" android:color="@color/filo" />
    <corners android:radius="999dp" />
</shape>
