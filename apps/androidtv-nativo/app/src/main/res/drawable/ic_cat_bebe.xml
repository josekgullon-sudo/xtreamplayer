<?xml version="1.0" encoding="utf-8"?>
<!--
  El mismo dibujo que en la web (components/Icon.tsx, «bebe»). Aquí en
  trazados sueltos porque un vector de Android no admite <circle> ni <rect>:
  todo tiene que ser <path>, así que los círculos van como arcos.
-->
