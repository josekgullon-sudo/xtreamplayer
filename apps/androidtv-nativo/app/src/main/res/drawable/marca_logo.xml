<?xml version="1.0" encoding="utf-8"?>
<!-- El sello de la marca: cuadrado blando con el rojo en diagonal, no plano.
     Un color plano se ve barato en una pantalla grande. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="315" android:startColor="@color/marca_viva" android:endColor="#A50F1C" />
    <corners android:radius="11dp" />
</shape>
