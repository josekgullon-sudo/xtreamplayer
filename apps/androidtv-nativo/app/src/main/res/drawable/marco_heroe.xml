<?xml version="1.0" encoding="utf-8"?>
<!-- El marco de la carátula del destacado: un filo y nada más. La imagen ya
     es la información; el marco solo la separa del fondo difuminado -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/elevada" />
    <stroke android:width="1dp" android:color="@color/filo_fuerte" />
    <corners android:radius="12dp" />
</shape>
