<?xml version="1.0" encoding="utf-8"?>
<!--
  El inicio.

  Todo va por pesos, sin una sola altura fija en la columna: una tele de
  1080p da 540 puntos de alto y el menú medía 548, así que los botones de
  abajo quedaban cortados por el borde de la pantalla. Con pesos, lo que
  sobra o falta lo absorben las tarjetas y encaja en cualquier tele.

  Los márgenes de los lados son generosos por lo mismo: casi todas las teles
  recortan un poco los bordes y lo que se pegue al filo no se ve.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- .pa-nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/barra"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <TextView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:text="T"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:background="@drawable/marca_logo" />

        <TextView
            android:id="@+id/marca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="13dp"
            android:text="TOTALplayer"
            android:textColor="@color/texto"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/quien"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:textColor="@color/tenue"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/hora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/apagado"
            android:textSize="19sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué quieres ver?"
            android:textColor="@color/texto"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elige con el mando y pulsa OK. Mantén pulsado para actualizar la lista."
            android:textColor="@color/tenue"
            android:textSize="14sp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="14dp" />

        <!-- Las tarjetas se quedan con lo que sobre, sea cual sea la tele -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <include
                android:id="@+id/tarjetaDirecto"
                layout="@layout/pieza_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space android:layout_width="20dp" android:layout_height="1dp" />

            <include
                android:id="@+id/tarjetaPelis"
                layout="@layout/pieza_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <Space android:layout_width="20dp" android:layout_height="1dp" />

            <include
                android:id="@+id/tarjetaSeries"
                layout="@layout/pieza_menu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/botonBuscar"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pastilla"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingEnd="26dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_buscar"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:text="Buscar un canal"
                    android:textColor="@color/apagado"
                    android:textSize="16sp" />
            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/botonActualizar"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pastilla"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingEnd="26dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_recargar"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:text="Actualizar listas"
                    android:textColor="@color/apagado"
                    android:textSize="16sp" />
            </LinearLayout>

            <Space android:layout_width="12dp" android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/botonSalir"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pastilla"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingEnd="26dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_salir"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:text="Cambiar de cuenta"
                    android:textColor="@color/apagado"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
