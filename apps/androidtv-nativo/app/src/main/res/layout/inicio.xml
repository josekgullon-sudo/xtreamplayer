<?xml version="1.0" encoding="utf-8"?>
<!--
  El menú, en un teléfono: las tres secciones apiladas y a lo ancho.

  Tres tarjetas en fila caben en una tele de 848 puntos útiles; en un móvil
  de 360 no cabe ni una y media. En vertical cada una tiene su sitio y se
  pulsa con el pulgar sin apuntar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <!-- La cabecera va centrada, como en la tele y como en la web.
                 Pegada a la izquierda parecía media pantalla vacía -->
            <TextView
                android:id="@+id/marca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TOTALPLAYER"
                android:textColor="@color/marca_viva"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:letterSpacing="0.22" />

            <TextView
                android:id="@+id/saludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Elige por dónde empezar. Podrás cambiar cuando quieras."
                android:textColor="@color/tenue"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <!-- Dos por fila, como en el reproductor web. La tercera se queda
                 sola a la izquierda y el hueco de al lado lo ocupa un vacío
                 del mismo ancho, para que no se estire a doble tamaño -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tarjetaDirecto"
                    layout="@layout/pieza_menu"
                    android:layout_width="0dp"
                    android:layout_height="176dp"
                    android:layout_weight="1" />

                <Space android:layout_width="12dp" android:layout_height="1dp" />

                <include
                    android:id="@+id/tarjetaPelis"
                    layout="@layout/pieza_menu"
                    android:layout_width="0dp"
                    android:layout_height="176dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tarjetaSeries"
                    layout="@layout/pieza_menu"
                    android:layout_width="0dp"
                    android:layout_height="176dp"
                    android:layout_weight="1" />

                <Space android:layout_width="12dp" android:layout_height="1dp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Lo secundario, en una barra abajo: donde llega el pulgar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/barra"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/botonBuscar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_buscar"
                android:tint="@color/apagado"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:textColor="@color/apagado"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonActualizar"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_recargar"
                android:tint="@color/apagado"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actualizar"
                android:textColor="@color/apagado"
                android:textSize="12sp"
                android:layout_marginTop="3dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/botonSalir"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_salir"
                android:tint="@color/apagado"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/textoSalir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
