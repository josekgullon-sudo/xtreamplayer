<?xml version="1.0" encoding="utf-8"?>
<!--
  El menú, con la misma cara que la web: todo centrado en mitad de la
  pantalla. Nombre de la marca pequeño arriba, el saludo grande, y las tres
  tarjetas debajo con el icono en grande.

  Antes era una barra a lo ancho, un titular pegado a la izquierda y las
  tarjetas apretadas contra el borde inferior. Sin nada centrado, la
  pantalla parecía un panel de configuración.

  Todo va por pesos: una tele de 1080p da 540 puntos de alto y cualquier
  altura fija acaba cortada por el borde.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/fondo"
    android:paddingStart="56dp"
    android:paddingEnd="56dp"
    android:paddingTop="26dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/marca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOTALPLAYER"
        android:textColor="@color/marca_viva"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.24" />

    <TextView
        android:id="@+id/saludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="34sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Elige por dónde empezar. Podrás cambiar cuando quieras."
        android:textColor="@color/tenue"
        android:textSize="16sp"
        android:layout_marginTop="8dp" />

    <!-- Las tres puertas, centradas y con el icono grande -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

        <include
            android:id="@+id/tarjetaDirecto"
            layout="@layout/pieza_menu"
            android:layout_width="300dp"
            android:layout_height="match_parent" />

        <Space android:layout_width="22dp" android:layout_height="1dp" />

        <include
            android:id="@+id/tarjetaPelis"
            layout="@layout/pieza_menu"
            android:layout_width="300dp"
            android:layout_height="match_parent" />

        <Space android:layout_width="22dp" android:layout_height="1dp" />

        <include
            android:id="@+id/tarjetaSeries"
            layout="@layout/pieza_menu"
            android:layout_width="300dp"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Lo de menos, centrado también y en voz baja -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/botonBuscar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pastilla"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_buscar"
                android:tint="@color/tenue"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Buscar"
                android:textColor="@color/tenue"
                android:textSize="15sp" />
        </LinearLayout>

        <Space android:layout_width="12dp" android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/botonActualizar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pastilla"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_recargar"
                android:tint="@color/tenue"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Actualizar listas"
                android:textColor="@color/tenue"
                android:textSize="15sp" />
        </LinearLayout>

        <Space android:layout_width="12dp" android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/botonSalir"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pastilla"
            android:focusable="true"
            android:paddingStart="20dp"
            android:paddingEnd="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_salir"
                android:tint="@color/tenue"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/textoSalir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/tenue"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
