<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/carpeta"
    android:focusable="true"
    android:padding="12dp"
    android:layout_marginBottom="6dp">

    <!-- La carátula del episodio: sin ella, una temporada son veinte
         renglones idénticos y no hay dónde mirar -->
    <ImageView
        android:id="@+id/foto"
        android:layout_width="132dp"
        android:layout_height="74dp"
        android:scaleType="centerCrop"
        android:background="@drawable/hueco_logo"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/numero"
        android:layout_width="62dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tenue"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/sinopsis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tenue"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      Guardarlo en el aparato, en la propia fila del episodio.

      De una serie se baja el episodio que quieras y no la serie entera:
      cuarenta ficheros y varios gigas no es una decisión que se tome sin
      querer pulsando un botón. Nace escondido y solo aparece donde se puede
      guardar —en un televisor con la aplicación nativa, sí—.
    -->
    <ImageView
        android:id="@+id/bajar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="10dp"
        android:padding="14dp"
        android:background="@drawable/circulo_accion"
        android:src="@drawable/ic_bajar"
        android:tint="@color/apagado"
        android:visibility="gone"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="Descargar este episodio" />
</LinearLayout>
