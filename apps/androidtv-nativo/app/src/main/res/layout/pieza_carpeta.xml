<?xml version="1.0" encoding="utf-8"?>
<!--
  Una carpeta de canales, en un teléfono.

  Era una línea de texto suelta. Sesenta líneas de texto en la única
  pantalla que hay para entrar al directo no dan ninguna pista de qué hay
  dentro: media lista empieza por la misma palabra —«DAZN SLB», «DAZN | F1»,
  «DAZN | EVENTOS»— y hay que leerlas enteras. Con el dibujo delante se
  distinguen sin leer, y con el número debajo se sabe si merece la pena
  entrar. Ver Categorias.java.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/carpeta"
    android:focusable="true"
    android:clickable="true"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:layout_marginBottom="3dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:duplicateParentState="true"
        android:background="@drawable/hueco_logo">

        <ImageView
            android:id="@+id/icono"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:duplicateParentState="true"
            android:tint="@color/icono_carpeta"
            android:contentDescription="@null" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cuantos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tenue"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/flecha"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_alante"
        android:tint="@color/tenue"
        android:contentDescription="@null" />
</LinearLayout>
