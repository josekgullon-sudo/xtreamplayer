<?xml version="1.0" encoding="utf-8"?>
<!--
  Una fila de canal, como .pa-live-chan del web: el logotipo en su cuadro,
  el nombre, y debajo lo que están dando cuando se sabe. Un nombre de canal
  no dice nada —«AXN HD» no es una razón para quedarse—; lo que hace parar
  de zapear es el título de lo que echan.

  La barra roja de la izquierda marca el que suena. Antes era un triángulo
  al final de la fila, donde no lo mira nadie.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/carpeta"
    android:focusable="true"
    android:paddingStart="10dp"
    android:paddingEnd="16dp"
    android:layout_marginBottom="3dp">

    <View
        android:id="@+id/sonando"
        android:layout_width="4dp"
        android:layout_height="38dp"
        android:background="@color/marca_viva"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="58dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp"
        android:scaleType="fitCenter"
        android:background="@drawable/hueco_logo"
        android:padding="4dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/nombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ahora"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tenue"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
