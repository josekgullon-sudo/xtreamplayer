<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo primero que se ve al encender.

  No es un adorno: entre que arranca la aplicación y que están las listas
  pasan unos segundos, y lo que había hasta ahora en esos segundos era una
  pantalla en blanco. Un logotipo que entra, una línea de marca que se abre
  y un acorde: lo mismo que hace cualquier aplicación por la que se paga.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_arranque">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <LinearLayout
            android:id="@+id/grupoLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sello"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:text="T"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold"
                android:background="@drawable/sello_grande" />

            <TextView
                android:id="@+id/nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="TOTALplayer"
                android:textColor="@color/texto"
                android:textSize="60sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- La línea que se abre debajo: la que da la sensación de que algo
             está pasando mientras se conecta -->
        <View
            android:id="@+id/linea"
            android:layout_width="360dp"
            android:layout_height="3dp"
            android:layout_marginTop="34dp"
            android:background="@drawable/linea_marca"
            android:scaleX="0" />

        <TextView
            android:id="@+id/lema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Tu televisión, donde quieras"
            android:textColor="@color/tenue"
            android:textSize="18sp"
            android:letterSpacing="0.08"
            android:alpha="0" />
    </LinearLayout>
</FrameLayout>
