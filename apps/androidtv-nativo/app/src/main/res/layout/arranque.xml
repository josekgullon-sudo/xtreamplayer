<?xml version="1.0" encoding="utf-8"?>
<!--
  El arranque, en un teléfono.

  Los mismos identificadores que la versión de tele, porque la animación es
  la misma. Lo que cambia son las medidas: «TOTALplayer» a 66sp pide más de
  600 puntos y un móvil normal tiene 360, así que la palabra se partía por la
  mitad —«TOTALpl / ayer»— y lo primero que se veía de la aplicación era el
  nombre roto.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_arranque">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <!-- El nombre, con el resplandor por detrás -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:id="@+id/halo"
                android:layout_width="330dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/halo_marca" />

            <TextView
                android:id="@+id/nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="TOTALplayer"
                android:textColor="@color/texto"
                android:textSize="38sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:letterSpacing="-0.02" />
        </FrameLayout>

        <View
            android:id="@+id/linea"
            android:layout_width="200dp"
            android:layout_height="3dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/linea_marca"
            android:scaleX="0" />

        <TextView
            android:id="@+id/lema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Tu televisión, donde quieras"
            android:textColor="@color/tenue"
            android:textSize="14sp"
            android:letterSpacing="0.10"
            android:alpha="0" />
    </LinearLayout>
</FrameLayout>
