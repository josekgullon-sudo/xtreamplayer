<?xml version="1.0" encoding="utf-8"?>
<!--
  La misma portada, en un teléfono.

  Los mismos identificadores que la de tele, porque la actividad es la
  misma, y el mismo banner de cuatro capas. Lo que cambia son las medidas: el
  banner baja de 300 a 260, el título de 38 a 25, la carátula de 200 a 150 y
  la cápsula de secciones flota abajo en vez de a la izquierda.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <FrameLayout
                android:id="@+id/heroe"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/fondo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:alpha="0.7"
                    android:contentDescription="@null" />

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="end">

                    <ImageView
                        android:id="@+id/heroeCartel"
                        android:layout_width="150dp"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        android:contentDescription="@null" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:background="@drawable/velo_arte" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/velo_lado" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/velo_portada" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|bottom"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/heroeTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/heroeDatos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/heroeSinopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="13sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp">

                        <Button
                            android:id="@+id/heroeVer"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="48dp"
                            android:text="Reproducir"
                            android:textColor="@color/texto"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:background="@drawable/boton" />

                        <FrameLayout
                            android:id="@+id/heroeBloqueNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/heroeAnillo"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progressDrawable="@drawable/anillo_nota" />

                            <TextView
                                android:id="@+id/heroeNota"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center"
                                android:textColor="@color/texto"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:id="@+id/filas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="10dp" />

            <TextView
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/tenue"
                android:textSize="15sp"
                android:padding="30dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/carril"
        layout="@layout/nav_secciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp" />

    <ProgressBar
        android:id="@+id/girando"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center" />
</FrameLayout>
