<?xml version="1.0" encoding="utf-8"?>
<!--
  La misma portada, en un teléfono.

  Los mismos identificadores que la de tele, porque la actividad es la
  misma. Lo que cambia son las medidas: el título baja de 42 a 26, la
  carátula del destacado de 196 a 104 y la cápsula de secciones flota abajo
  en vez de a la izquierda.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:scaleType="centerCrop"
        android:alpha="0.3"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:background="@drawable/velo_lado" />

    <View
        android:layout_width="match_parent"
        android:layout_height="330dp"
        android:background="@drawable/velo_portada" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="90dp">

            <LinearLayout
                android:id="@+id/heroe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="24dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/heroeTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/heroeDatos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/heroeSinopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="14sp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:layout_marginTop="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <Button
                            android:id="@+id/heroeVer"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="52dp"
                            android:text="Reproducir"
                            android:textColor="@color/texto"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:background="@drawable/boton" />

                        <FrameLayout
                            android:id="@+id/heroeBloqueNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/heroeAnillo"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progressDrawable="@drawable/anillo_nota" />

                            <TextView
                                android:id="@+id/heroeNota"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:gravity="center"
                                android:textColor="@color/texto"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/marco_heroe"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/heroeCartel"
                        android:layout_width="104dp"
                        android:layout_height="156dp"
                        android:scaleType="centerCrop"
                        android:visibility="invisible"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/tenue"
                android:textSize="15sp"
                android:padding="30dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/carril"
        layout="@layout/nav_secciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp" />

    <ProgressBar
        android:id="@+id/girando"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="center" />
</FrameLayout>
