<?xml version="1.0" encoding="utf-8"?>
<!--
  Una fila de la portada: su rótulo y sus carteles.

  El rótulo va en blanco y a secas, todas las filas igual. La primera
  versión le ponía al de la primera una pastilla roja sólida —la referencia
  lo hace así—, y en la tele quedaban dos manchas rojas seguidas: el botón
  de «Reproducir» del banner y la pastilla justo debajo. Con el rótulo en
  blanco, lo único de color en la pantalla es lo que se puede pulsar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/rotulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="19sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="4dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/carteles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:clipToPadding="false"
        android:focusable="false" />
</LinearLayout>
