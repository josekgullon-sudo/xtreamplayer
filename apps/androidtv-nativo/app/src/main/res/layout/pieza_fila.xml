<?xml version="1.0" encoding="utf-8"?>
<!--
  Una fila de la portada: su rótulo y sus carteles.

  El rótulo de la primera va en una pastilla sólida y el de las demás en
  blanco a secas, como en la referencia: no todas las filas pesan lo mismo,
  y lo que se quiere destacar tiene que verse destacado sin leerlo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/rotulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="20sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="6dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/carteles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:clipToPadding="false"
        android:focusable="false" />
</LinearLayout>
