<?xml version="1.0" encoding="utf-8"?>
<!--
  Un canal en una fila del inicio.

  Es la misma celda que la de cine pero con la forma que le toca, y eso no
  es un capricho: un logotipo de canal metido en un cartel de 2:3 y recortado
  al centro se convierte en un «1» de un palmo que ocupa media pantalla y no
  se parece a nada. Los canales son apaisados y su logotipo tiene que caber
  entero, no llenar el hueco: 16:9, la imagen ajustada dentro y aire
  alrededor.

  Los identificadores son los mismos que en `pieza_poster` a propósito: la
  celda del adaptador es la misma y no tiene que saber cuál de las dos le ha
  tocado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/poster"
    android:focusable="true"
    android:padding="6dp"
    android:layout_margin="8dp">

    <!--
      El logotipo, más pequeño que antes.

      Ocupaba 200×113 con el nombre en 14 puntos debajo, y como el logotipo
      que manda medio panel es el NÚMERO del canal, la fila entera eran
      cifras enormes y unos nombres que desde el sofá no se leían. El que
      tiene que mandar en la celda es el nombre, y debajo lo que echan.
    -->
    <FrameLayout
        android:id="@+id/marcoCartel"
        android:layout_width="196dp"
        android:layout_height="94dp"
        android:background="@color/elevada">

        <TextView
            android:id="@+id/sinCartel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/apagado"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Ajustada y con aire: un logotipo recortado no se reconoce -->
        <ImageView
            android:id="@+id/cartel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Un renglón: los nombres de canal son cortos, y con dos, el hueco
         vacío de debajo se comía media celda -->
    <TextView
        android:id="@+id/nombre"
        android:layout_width="196dp"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="16sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="9dp" />

    <!-- Lo que echan ahora. El renglón se reserva aunque venga vacío: si no,
         la fila entera pega un salto de alto cuando llega la guía, un
         segundo después de pintarse -->
    <TextView
        android:id="@+id/extra"
        android:layout_width="196dp"
        android:layout_height="wrap_content"
        android:textColor="@color/apagado"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="2dp" />
</LinearLayout>
