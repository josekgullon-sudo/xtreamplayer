<?xml version="1.0" encoding="utf-8"?>
<!--
  Un canal en una fila del inicio.

  Es la misma celda que la de cine pero con la forma que le toca, y eso no
  es un capricho: un logotipo de canal metido en un cartel de 2:3 y recortado
  al centro se convierte en un «1» de un palmo que ocupa media pantalla y no
  se parece a nada. Los canales son apaisados y su logotipo tiene que caber
  entero, no llenar el hueco: 16:9, la imagen ajustada dentro y aire
  alrededor.

  Los identificadores son los mismos que en `pieza_poster` a propósito: la
  celda del adaptador es la misma y no tiene que saber cuál de las dos le ha
  tocado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/poster"
    android:focusable="true"
    android:padding="6dp"
    android:layout_margin="8dp">

    <FrameLayout
        android:id="@+id/marcoCartel"
        android:layout_width="200dp"
        android:layout_height="113dp"
        android:background="@color/elevada">

        <TextView
            android:id="@+id/sinCartel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/apagado"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Ajustada y con aire: un logotipo recortado no se reconoce -->
        <ImageView
            android:id="@+id/cartel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/nombre"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="14sp"
        android:maxLines="2"
        android:minLines="2"
        android:lineSpacingExtra="1dp"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/extra"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:textColor="@color/tenue"
        android:textSize="12.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
