<?xml version="1.0" encoding="utf-8"?>
<!--
  Un cartel de la fila numerada.

  El número va enorme, pegado al borde de abajo y saliéndose de la carátula
  por la izquierda, como en cualquier aplicación de este tipo: es lo que
  hace que se lea como un ranking y no como una fila más. Los mismos
  identificadores que el cartel normal —«cartel», «nombre», «extra»,
  «sinCartel»— porque los rellena el mismo adaptador.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="34dp"
        android:background="@drawable/poster"
        android:focusable="true"
        android:padding="6dp">

        <FrameLayout
            android:id="@+id/marcoCartel"
            android:layout_width="132dp"
            android:layout_height="198dp"
            android:background="@color/elevada">

            <TextView
                android:id="@+id/sinCartel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/apagado"
                android:textSize="12sp"
                android:maxLines="4"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/cartel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/nombre"
            android:layout_width="132dp"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/extra"
            android:layout_width="132dp"
            android:layout_height="wrap_content"
            android:textColor="@color/tenue"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/puesto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="34dp"
        android:textColor="@color/marca_viva"
        android:textSize="76sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />
</FrameLayout>
