<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla completa.

  El cartel de arriba sale al cambiar de canal y se va solo a los cinco
  segundos: en una tele, saber qué has puesto es lo único que hace falta ver
  encima de la imagen, y ver algo encima de la imagen todo el rato es lo que
  hace que la gente cierre la aplicación.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/girando"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/marca" />

    <!-- El cartel de canal -->
    <LinearLayout
        android:id="@+id/cartelito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/velo"
        android:paddingStart="46dp"
        android:paddingEnd="46dp"
        android:paddingTop="34dp"
        android:paddingBottom="34dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="72dp"
            android:layout_height="56dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="20dp">

            <TextView
                android:id="@+id/nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="27sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ahora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="17sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/reloj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/apagado"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- Cuando algo no arranca, decirlo: una pantalla negra y muda es
         indistinguible de un aparato colgado -->
    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="19sp"
        android:lineSpacingExtra="6dp"
        android:paddingStart="80dp"
        android:paddingEnd="80dp"
        android:visibility="gone" />
</FrameLayout>
