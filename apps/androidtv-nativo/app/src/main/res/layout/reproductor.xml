<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla completa, en un teléfono.

  Los mismos identificadores que la versión de tele, porque la actividad es
  la misma. Lo que cambia son las medidas: 56 puntos de margen y letras de
  27sp son las de una pantalla que se mira a tres metros; aquí tapaban media
  imagen. Y la superficie es de textura, por lo mismo que en el directo: hay
  móviles en los que la de siempre se corrompe a los pocos segundos y la
  imagen se convierte en ruido de colores con el sonido perfecto.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:surface_type="texture_view" />

    <ProgressBar
        android:id="@+id/girando"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateDrawable="@drawable/girando"
        android:indeterminateDuration="800" />

    <!-- El cartel de la película -->
    <LinearLayout
        android:id="@+id/cartelito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/velo"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/nombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ahora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/reloj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/apagado"
            android:textSize="14sp" />
    </LinearLayout>

    <!--
      Los mandos, hechos aquí.

      Los que trae ExoPlayer de serie se pintan con el foco del sistema: un
      recuadro verde chillón en medio de la pantalla. Estos son los de la
      marca, y además el directo no los enseña, porque en el directo no hay
      nada que rebobinar.
    -->
    <LinearLayout
        android:id="@+id/mandos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/velo_bajo"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/vaPor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="54dp"
                android:text="0:00"
                android:textColor="@color/texto"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/avance"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:max="1000"
                android:progressDrawable="@drawable/barra_avance" />

            <TextView
                android:id="@+id/dura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="54dp"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/apagado"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <ImageView
                android:id="@+id/teclaAtras"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="15dp"
                android:src="@drawable/ic_atras"
                android:background="@drawable/tecla"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/teclaPausa"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="22dp"
                android:layout_marginEnd="22dp"
                android:padding="18dp"
                android:src="@drawable/ic_pausa"
                android:background="@drawable/tecla"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/teclaAlante"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:padding="15dp"
                android:src="@drawable/ic_alante"
                android:background="@drawable/tecla"
                android:focusable="true"
                android:clickable="true"
                android:contentDescription="@null" />

            <!-- El idioma, cuando lo hay. Ver la variante de televisor -->
            <TextView
                android:id="@+id/teclaIdioma"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="18dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="Idioma"
                android:textColor="@color/texto"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/tecla"
                android:focusable="true"
                android:clickable="true"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cuando algo no arranca, decirlo: una pantalla negra y muda es
         indistinguible de un aparato colgado -->
    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:visibility="gone" />
</FrameLayout>
