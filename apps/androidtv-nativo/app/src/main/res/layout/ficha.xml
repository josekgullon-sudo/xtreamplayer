<?xml version="1.0" encoding="utf-8"?>
<!-- La ficha en el teléfono: cartel arriba, todo lo demás debajo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.14"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/velo_bajo" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="26dp"
            android:paddingBottom="30dp">

            <ImageView
                android:id="@+id/cartel"
                android:layout_width="160dp"
                android:layout_height="240dp"
                android:scaleType="centerCrop"
                android:background="@color/superficie"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="18dp" />


            <!--
              Los mismos datos que en la tele y en el mismo orden, pero en
              una fila que se arrastra: cinco píldoras no caben en los 360
              puntos de un móvil y partirlas en dos líneas descoloca todo lo
              que va debajo.
            -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/chipNota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/chip_ficha"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/texto" android:textSize="13sp"
                        android:textStyle="bold" android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipAnio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/chip_ficha"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/texto" android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipTemporadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/chip_ficha"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/texto" android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipEdad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/chip_ficha"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/texto" android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipDuracion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/chip_ficha"
                        android:paddingStart="12dp" android:paddingEnd="12dp"
                        android:paddingTop="5dp" android:paddingBottom="5dp"
                        android:textColor="@color/texto" android:textSize="13sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/chipCalidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/chip_calidad"
                        android:paddingStart="10dp" android:paddingEnd="10dp"
                        android:paddingTop="4dp" android:paddingBottom="4dp"
                        android:textColor="@color/apagado" android:textSize="12sp"
                        android:textStyle="bold" android:visibility="gone" />
                </LinearLayout>
            </HorizontalScrollView>
            <TextView
                android:id="@+id/datos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/apagado"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginTop="18dp">

                <TextView
                    android:id="@+id/botonVer"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="54dp"
                    android:text="Ver ahora"
                    android:textColor="@color/texto"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/boton" 
                            android:gravity="center"
                            android:focusable="true"
                            android:clickable="true" />

                <!--
                     El icono, con su palabra debajo.

                     Un icono suelto hay que probarlo para saber qué hace, y un corazón
                     lo mismo es «me gusta» que «guardar» que «seguir». En el ordenador
                     el rótulo va al lado; aquí debajo, que es donde cabe sin empujar
                     «Ver ahora» fuera de la fila.

                     La columna no coge el foco: lo sigue cogiendo el icono, que es lo
                     que el código conoce por su identificador.
                -->
                <LinearLayout
                    android:id="@+id/bloqueFavorito"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginStart="10dp"
                    android:focusable="false">

                    <ImageView
                        android:id="@+id/botonFavorito"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:padding="15dp"
                        android:background="@drawable/circulo_accion"
                        android:src="@drawable/ic_corazon"
                        android:tint="@color/apagado"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="Favorito" />

                    <TextView
                        android:id="@+id/etiquetaFavorito"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Mi lista"
                        android:textColor="@color/apagado"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <!--
                     Guardarlo en el aparato, al lado de reproducirlo y de marcarlo.
                     Nace escondido: solo aparece cuando la ficha es de algo que se puede
                     bajar —una película o un episodio— y hay hueco donde guardarlo.
                -->
                <LinearLayout
                    android:id="@+id/bloqueBajar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginStart="10dp"
                    android:visibility="gone"
                    android:focusable="false">

                    <ImageView
                        android:id="@+id/botonBajar"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:padding="15dp"
                        android:background="@drawable/circulo_accion"
                        android:src="@drawable/ic_bajar"
                        android:tint="@color/apagado"
                        android:focusable="true"
                        android:clickable="true"
                        android:contentDescription="Descargar" />

                    <TextView
                        android:id="@+id/etiquetaBajar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Descargar"
                        android:textColor="@color/apagado"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/bloqueNota"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/anilloNota"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progressDrawable="@drawable/anillo_nota" />

                    <TextView
                        android:id="@+id/textoNota"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:gravity="center"
                        android:textColor="@color/texto"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- En el móvil el rótulo del porcentaje no cabe al lado, y
                     el círculo con su número ya se entiende solo -->
                <TextView
                    android:id="@+id/pieNota"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:text="Calificación de los usuarios"
                    android:visibility="gone" />
            </LinearLayout>

            <!--
                 El reparto con la cara de cada uno, cuando se sabe.

                 Nace escondido: solo hay caras si nuestro servidor reconoce el título.
                 Cuando no las hay se queda el «Elenco» de siempre, que son los nombres
                 que manda el panel en una línea.
            -->
            <TextView
                android:id="@+id/rotuloReparto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reparto"
                android:textColor="@color/marca_viva"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/bloqueReparto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:layout_marginTop="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/filaReparto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/rotuloElenco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Elenco"
                android:textColor="@color/marca_viva"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/elenco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="14sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:layout_marginTop="3dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/rotuloGeneros"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Géneros"
                android:textColor="@color/marca_viva"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/generos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="3dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/sinopsis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="20dp" />

            <LinearLayout
                android:id="@+id/bloqueSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/temporadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/episodios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/girando"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/marca"
        android:visibility="gone" />
</FrameLayout>
