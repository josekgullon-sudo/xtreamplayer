<?xml version="1.0" encoding="utf-8"?>
<!--
  TV en directo, en un teléfono.

  Mismos identificadores que la versión de tele, porque la actividad es la
  misma; lo que cambia es que aquí las tres partes no caben una al lado de
  otra. Van apiladas y se enseña una cada vez: carpetas, canales y vídeo.
  Atrás va deshaciendo el camino, que es como se navega en un móvil.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!--
      El envoltorio que en la tele reserva el hueco del carril. Aquí no
      reserva nada —el carril del teléfono flota abajo— pero lleva el mismo
      identificador porque la actividad es la misma y le quita ese hueco al
      pasar a pantalla completa.
    -->
    <FrameLayout
        android:id="@+id/filaDirecto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Carpetas -->
    <LinearLayout
        android:id="@+id/columnaCarpetas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo"
        android:paddingTop="20dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TV EN DIRECTO"
            android:textColor="@color/tenue"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCarpetas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Canales -->
    <LinearLayout
        android:id="@+id/columnaCanales"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/fondo"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tituloCarpeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/cuantos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/contador"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/tenue"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCanales"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clipToPadding="false" />

        <LinearLayout
            android:id="@+id/bloqueVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Esta carpeta no tiene canales."
                android:textColor="@color/apagado"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/botonReintentar"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pastilla"
                android:focusable="true"
                android:clickable="true"
                android:paddingStart="18dp"
                android:paddingEnd="22dp"
                android:layout_marginTop="12dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:src="@drawable/ic_recargar"
                    android:tint="@color/texto"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:text="Volver a cargar"
                    android:textColor="@color/texto"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!--
      El vídeo.

      La caja mide 16:9 y no se estira: dándole todo el alto de un móvil en
      vertical, un canal de televisión salía con dos franjas negras enormes
      arriba y abajo que parecían un fallo de la imagen. Debajo va lo que
      echan, y al tocar la imagen la caja pasa a ocuparlo todo.

      La superficie es de textura y no de las de siempre. En el teléfono, un
      SurfaceView es un plano aparte que compone la pantalla del aparato por
      su cuenta, y hay móviles en los que ese plano se corrompe a los pocos
      segundos: el sonido sigue perfecto y la imagen se convierte en ruido de
      colores. Un TextureView se pinta como cualquier otra vista y ese camino
      no existe. En la tele se deja el de siempre, que es el que va por
      hardware y el que aguanta un Fire TV Stick.
    -->
    <LinearLayout
        android:id="@+id/columnaVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#000000"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/caja"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/vista"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:surface_type="texture_view" />

            <TextView
                android:id="@+id/pista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Elige un canal de la lista"
                android:textColor="@color/tenue"
                android:textSize="15sp"
                android:padding="20dp" />

            <ProgressBar
                android:id="@+id/girando"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/marca"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/bloqueInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/superficie"
            android:padding="16dp">

            <TextView
                android:id="@+id/nombreCanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/etiquetaAhora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AHORA"
                android:textColor="@color/marca_viva"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ahora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/etiquetaLuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESPUÉS"
                android:textColor="@color/tenue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:layout_marginTop="10dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/luego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="3dp" />

            <TextView
                android:id="@+id/comoAmpliar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toca el vídeo para verlo a pantalla completa"
                android:textColor="@color/tenue"
                android:textSize="12sp"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    </FrameLayout>

    <!-- La cápsula de secciones, flotando abajo. Va la última del
         FrameLayout para quedar por encima de las capas de contenido -->
    <include
        android:id="@+id/carril"
        layout="@layout/nav_secciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp" />
</FrameLayout>
