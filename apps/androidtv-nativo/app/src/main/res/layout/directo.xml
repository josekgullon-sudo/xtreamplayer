<?xml version="1.0" encoding="utf-8"?>
<!--
  TV en directo: carpetas, canales y lo que se está viendo.

  El vídeo va a la derecha y pequeño a propósito: lo que se hace aquí es
  buscar canal, y para eso hay que ver la lista. Cuando ya se ha elegido, con
  otro OK se va a pantalla completa, que es donde se ve la tele.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/fondo">

    <!-- Carpetas -->
    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/superficie"
        android:paddingTop="26dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TV EN DIRECTO"
            android:textColor="@color/tenue"
            android:textSize="13sp"
            android:letterSpacing="0.14"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCarpetas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Canales -->
    <LinearLayout
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#101017"
        android:paddingTop="26dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tituloCarpeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto"
            android:textSize="19sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCanales"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Esta carpeta no tiene canales."
            android:textColor="@color/tenue"
            android:textSize="15sp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Lo que se ve -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/vista"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/pista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Elige un canal de la lista"
                android:textColor="@color/tenue"
                android:textSize="17sp"
                android:padding="20dp" />

            <ProgressBar
                android:id="@+id/girando"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/marca"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Qué se está viendo y qué echan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/superficie"
            android:padding="22dp">

            <TextView
                android:id="@+id/nombreCanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="21sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ahora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/luego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tenue"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/comoAmpliar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pulsa OK otra vez para verlo a pantalla completa"
                android:textColor="@color/tenue"
                android:textSize="13sp"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
