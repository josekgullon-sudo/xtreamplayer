<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrar, en un teléfono.

  Los mismos identificadores que la versión de tele —la actividad es la
  misma—, pero en vertical y a lo ancho de la pantalla: los campos de 640
  puntos de la tele se salen de un móvil de 360.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- El logotipo es el nombre: «TOTAL» blanco y «player» rojo. El
                 color se pone desde el código, en Marca -->
            <TextView
                android:id="@+id/nombreMarca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="TOTALplayer"
                android:textColor="@color/texto"
                android:textSize="30sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/aviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Entra con el usuario y la contraseña que te dio tu proveedor"
                android:textColor="@color/apagado"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/porQueNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:background="@drawable/aviso_malo"
                android:padding="14dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/campoUsuario"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Usuario"
                android:textColorHint="@color/tenue"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:background="@drawable/campo"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:layout_marginBottom="12dp" />

            <EditText
                android:id="@+id/campoClave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Contraseña"
                android:textColorHint="@color/tenue"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:background="@drawable/campo"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/botonEntrar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Entrar"
                android:textColor="@color/texto"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/boton" 
                            android:gravity="center"
                            android:focusable="true"
                            android:clickable="true" />

            <TextView
                android:id="@+id/botonPropia"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Usar mi lista M3U o Xtream"
                android:textColor="@color/apagado"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:gravity="center"
                android:background="@drawable/pastilla"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:id="@+id/bloquePropia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pega la dirección de tu servidor Xtream o el enlace de tu lista M3U. El usuario y la contraseña de arriba son los de esa lista."
                    android:textColor="@color/tenue"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/campoServidor"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="http://servidor.com:8080  ·  o un enlace .m3u"
                    android:textColorHint="@color/tenue"
                    android:textColor="@color/texto"
                    android:textSize="15sp"
                    android:background="@drawable/campo"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/cargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/velo_espera"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateDrawable="@drawable/girando"
            android:indeterminateDuration="800" />

        <TextView
            android:id="@+id/textoCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrando…"
            android:textColor="@color/texto"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</FrameLayout>
