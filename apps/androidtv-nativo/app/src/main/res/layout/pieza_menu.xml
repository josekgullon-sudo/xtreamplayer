<?xml version="1.0" encoding="utf-8"?>
<!--
  Una tarjeta de sección, calcada de .feature-card: el icono en rojo dentro
  de un cuadrado de rojo diluido, el título debajo y una línea que diga qué
  hay dentro. El contenido se reparte por la tarjeta en vez de quedarse
  amontonado en la esquina de abajo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/tarjeta"
    android:focusable="true"
    android:paddingStart="30dp"
    android:paddingEnd="30dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:background="@drawable/insignia">

        <ImageView
            android:id="@+id/icono"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:tint="@color/marca_viva"
            android:contentDescription="@null" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="26sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/apagado"
        android:textSize="16sp"
        android:layout_marginTop="7dp"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
