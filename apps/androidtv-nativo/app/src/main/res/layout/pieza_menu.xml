<?xml version="1.0" encoding="utf-8"?>
<!--
  Una tarjeta de sección en el teléfono, igual que en el reproductor web:
  el icono grande dentro de su cuadro rojo diluido, arriba y centrado, y el
  nombre debajo. También centrado.

  Antes iban en fila —icono pequeño a la izquierda, textos a la derecha, una
  tarjeta debajo de otra a lo ancho de la pantalla— y parecía una lista de
  ajustes, no la portada de un reproductor. Dos por fila y en vertical es lo
  que ya funciona en la web.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/tarjeta"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:focusable="true"
    android:clickable="true">

    <FrameLayout
        android:layout_width="74dp"
        android:layout_height="74dp"
        android:background="@drawable/insignia">

        <ImageView
            android:id="@+id/icono"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:tint="@color/marca_viva"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tenue"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />
</LinearLayout>
