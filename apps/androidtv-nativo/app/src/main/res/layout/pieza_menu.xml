<?xml version="1.0" encoding="utf-8"?>
<!--
  Una tarjeta de sección: el icono grande arriba, centrado, y debajo el
  nombre. Como en la web. El icono es lo que se reconoce desde el sofá
  antes de leer nada, así que manda él.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/tarjeta"
    android:focusable="true"
    android:padding="22dp">

    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:background="@drawable/insignia">

        <ImageView
            android:id="@+id/icono"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:tint="@color/marca_viva"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/texto"
        android:textSize="24sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="18dp" />

    <TextView
        android:id="@+id/detalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tenue"
        android:textSize="14sp"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
