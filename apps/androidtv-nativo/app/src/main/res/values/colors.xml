<?xml version="1.0" encoding="utf-8"?>
<!--
  La paleta del reproductor web, la misma exacta.
  Ver :root en app/globals.css: si allí cambia la marca, aquí también.

  Lo importante, y es justo lo que estaba mal: los fondos van en gris, no en
  negro. El problema de una interfaz oscura no es que sea oscura, es que
  todo caiga en el mismo tono y no se distinga una tarjeta de su fondo. Cada
  escalón sube lo justo para verse, y los bordes son los que dibujan de
  verdad dónde acaba cada cosa.
-->
<resources>
    <color name="fondo">#201F28</color>
    <color name="superficie">#2E2B39</color>
    <color name="elevada">#3C3849</color>
    <!-- La columna de canales: entre el fondo y la de carpetas, para que se
         vean como dos columnas y no como una sola -->
    <color name="columna">#282631</color>
    <color name="encima">#4A4559</color>
    <color name="borde">#565068</color>
    <color name="borde_fuerte">#706888</color>

    <!-- Las líneas finas del web: blanco a muy poca opacidad -->
    <color name="filo">#1CFFFFFF</color>
    <color name="filo_fuerte">#30FFFFFF</color>
    <color name="tranquilo">#0FFFFFFF</color>

    <color name="marca">#E5192B</color>
    <color name="marca_viva">#FF4152</color>
    <!-- accent-tint y accent-tint-strong del web -->
    <color name="marca_tinte">#2EE5192B</color>
    <color name="marca_tinte_fuerte">#47E5192B</color>

    <color name="texto">#F7F5F9</color>
    <color name="apagado">#BDB6C7</color>
    <color name="tenue">#948CA1</color>
</resources>
