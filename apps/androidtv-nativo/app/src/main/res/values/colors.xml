<?xml version="1.0" encoding="utf-8"?>
<!--
  Los grises, neutros de verdad.

  El web usa un gris con una pizca de violeta (#201F28) y en un monitor se ve
  gris. En un televisor no: la tele satura, y ese violeta salía azul eléctrico
  con las tarjetas en lila y el rojo de la marca en fucsia. Parecía otra
  aplicación, y no una buena.

  Así que los mismos escalones y la misma estructura que el web —fondo,
  superficie, elevada, filo—, pero sin violeta. Lo que en el monitor era gris
  aquí sigue siendo gris. Y el rojo, que es lo único con color, se reserva
  para el foco y para la marca.
-->
<resources>
    <color name="fondo">#101012</color>
    <color name="columna">#151517</color>
    <color name="superficie">#1B1B1F</color>
    <color name="elevada">#26262B</color>
    <color name="encima">#33333A</color>
    <color name="borde">#3A3A42</color>
    <color name="borde_fuerte">#4E4E58</color>

    <!-- Las líneas finas: blanco a muy poca opacidad, como el web -->
    <color name="filo">#1FFFFFFF</color>
    <color name="filo_fuerte">#33FFFFFF</color>
    <color name="tranquilo">#12FFFFFF</color>

    <color name="marca">#E5192B</color>
    <color name="marca_viva">#FF3B4D</color>
    <!--
      El tinte del foco, flojo a propósito. Al 28% la tele lo convertía en un
      bloque fucsia que se comía la tarjeta entera: en una pantalla que
      satura, quien marca el foco tiene que ser el borde, no el relleno.
    -->
    <color name="marca_tinte">#1FE5192B</color>
    <color name="marca_tinte_fuerte">#2BE5192B</color>

    <!-- El negro del logotipo. No es el fondo de la aplicación: el icono y el
         estante de la tele van sobre negro de verdad, y ahí un gris se nota -->
    <color name="negro_marca">#0A0A0B</color>

    <color name="texto">#FFFFFF</color>
    <color name="apagado">#B4B4BE</color>
    <color name="tenue">#87878F</color>
</resources>
