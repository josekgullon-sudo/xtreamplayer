<?xml version="1.0" encoding="utf-8"?>
<!--
  El carril de secciones, a tres metros del sofá.

  Pasar de las películas a las series eran dos ATRÁS y volver a recorrer el
  menú con las flechas. Con el carril siempre a la izquierda, es ◀ y OK.

  Va dentro de un ScrollView porque una tele no tiene la altura que parece:
  entre el sobrebarrido y los 540 puntos útiles, el quinto destino se salía
  por abajo y «Buscar» no llegaba a verse.

  Los mismos identificadores que la cápsula del teléfono: los engancha el
  mismo código (Navegacion.java) y las dos pantallas hacen lo mismo.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="92dp"
    android:layout_height="match_parent"
    android:background="@drawable/carril"
    android:scrollbars="none"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/carril"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/carril_item"
            android:focusable="true"
            android:clickable="true">

            <FrameLayout
                android:id="@+id/navInicioPastilla"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/carril_icono">

                <ImageView
                    android:id="@+id/navInicioIcono"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_casa"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/navInicioTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="@color/apagado"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navDirecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/carril_item"
            android:focusable="true"
            android:clickable="true">

            <FrameLayout
                android:id="@+id/navDirectoPastilla"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/carril_icono">

                <ImageView
                    android:id="@+id/navDirectoIcono"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tv"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/navDirectoTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Directo"
                android:textColor="@color/apagado"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navCine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/carril_item"
            android:focusable="true"
            android:clickable="true">

            <FrameLayout
                android:id="@+id/navCinePastilla"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/carril_icono">

                <ImageView
                    android:id="@+id/navCineIcono"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cine"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/navCineTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cine"
                android:textColor="@color/apagado"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/carril_item"
            android:focusable="true"
            android:clickable="true">

            <FrameLayout
                android:id="@+id/navSeriesPastilla"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/carril_icono">

                <ImageView
                    android:id="@+id/navSeriesIcono"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_series"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/navSeriesTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Series"
                android:textColor="@color/apagado"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/navBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/carril_item"
            android:focusable="true"
            android:clickable="true">

            <FrameLayout
                android:id="@+id/navBuscarPastilla"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/carril_icono">

                <ImageView
                    android:id="@+id/navBuscarIcono"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_buscar"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/navBuscarTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buscar"
                android:textColor="@color/apagado"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

</ScrollView>
