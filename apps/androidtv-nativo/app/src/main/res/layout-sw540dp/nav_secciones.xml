        android:gravity="center_vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/carril_item"
            android:focusable="true"
            android:clickable="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/navInicioIcono"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_casa"
                    android:tint="@color/apagado"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/navInicioTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Inicio"
                    android:textColor="@color/apagado"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:visibility="invisible"
                    android:layout_marginStart="9dp" />
            </LinearLayout>

            <!-- La raya: dice en qué sección ESTÁS. Nada que ver con el foco,
                 que lo pinta el marco del botón -->
            <View
                android:id="@+id/navInicioPastilla"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/carril_icono" />
        </LinearLayout>

