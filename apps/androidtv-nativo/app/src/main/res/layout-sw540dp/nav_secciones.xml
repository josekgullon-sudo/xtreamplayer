<?xml version="1.0" encoding="utf-8"?>
<!--
  El carril de secciones, a tres metros del sofá.

  Con la etiqueta debajo, en pequeño. Se probó sin ellas —la referencia no
  las lleva— y en una tele de verdad no hay quien sepa cuál es cine y cuál
  series: los dos dibujos son un rectángulo con algo dentro, y a tres
  metros esa diferencia no existe. Once puntos de letra ocupan poco y
  quitan la duda. La versión anterior llevaba cada icono en una
  pastilla de 58 con su etiqueta debajo, y entre eso y el ancho de la
  columna el nombre de la carpeta de al lado se quedaba en «AUT…». A tres
  metros el dibujo ya se reconoce; la palabra solo roba sitio a lo que se
  ha venido a ver.

  Dos señales distintas y visibles a la vez: dónde tienes el mando —el
  marco de foco, que pinta el fondo del botón— y en qué sección estás —la
  raya corta de debajo del icono—. Antes eran la misma cosa y no se
  entendía ninguna.

  Los mismos identificadores que la cápsula del teléfono: los engancha el
  mismo código (Navegacion.java).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="78dp"
    android:layout_height="match_parent"
    android:background="@drawable/carril"
    android:scrollbars="none"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:background="@drawable/carril_item"
            android:focusable="true"
            android:clickable="true">

            <ImageView
                android:id="@+id/navInicioIcono"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_casa"
                android:tint="@color/apagado"
                android:contentDescription="@null" />

            <!-- La raya: dice en qué sección ESTÁS, y va pegada al icono.
                 Se enciende desde Navegacion.java y no tiene nada que ver
                 con el foco, que lo pinta el marco del botón -->
            <View
                android:id="@+id/navInicioPastilla"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/carril_icono" />

            <TextView
                android:id="@+id/navInicioTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Inicio"
                android:textColor="@color/apagado"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="5dp" />
        </LinearLayout>
