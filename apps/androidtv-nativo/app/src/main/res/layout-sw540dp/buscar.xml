<?xml version="1.0" encoding="utf-8"?>
<!-- Buscar, en todo: canales, películas y series. En una lista de ocho mil
     canales y treinta mil títulos, ir carpeta por carpeta no es una opción,
     y saber de antemano en cuál de las tres secciones está lo que se busca,
     tampoco. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <!-- La misma barra que el menú: al entrar aquí no se cambia de aplicación -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/barra"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Buscar"
            android:textColor="@color/texto"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp">

    <!--
      El campo y el micrófono.

      Escribir «Los Simpson» con el mando son once viajes por un teclado en
      pantalla, letra a letra, con las flechas. Es la parte más pesada de la
      aplicación con diferencia, y el mando del Fire TV lleva micrófono. El
      botón nace escondido y solo sale si el aparato sabe escuchar — ver
      BuscarActivity.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/campo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="66dp"
            android:hint="Un título, una serie o un canal"
            android:textColorHint="@color/tenue"
            android:textColor="@color/texto"
            android:textSize="19sp"
            android:background="@drawable/campo"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:inputType="text"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <ImageView
            android:id="@+id/botonVoz"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginStart="14dp"
            android:padding="19dp"
            android:src="@drawable/ic_micro"
            android:background="@drawable/tecla"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone"
            android:contentDescription="Buscar hablando" />
    </LinearLayout>

    <TextView
        android:id="@+id/cuantos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/tenue"
        android:textSize="15sp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/resultados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
</LinearLayout>
