<?xml version="1.0" encoding="utf-8"?>
<!--
  La portada de cine y de series, en un televisor.

  Antes esta sección era una columna de carpetas y una rejilla: había que
  saber en qué carpeta buscar antes de poder mirar nada. Esto contesta a
  «¿y qué veo?», que es la pregunta con la que se entra: un título grande
  arriba con su ficha, y debajo filas de carteles.

  Es un ScrollView y no una lista reciclada a propósito. Son seis u ocho
  filas contadas, cada una con su propia lista horizontal dentro; una lista
  vertical reciclando listas horizontales es justo donde el foco de un mando
  se pierde, y el ahorro de memoria aquí no existe.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!-- El fondo del título destacado, difuminado por el velo de encima -->
    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:scaleType="centerCrop"
        android:alpha="0.5"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="440dp"
        android:background="@drawable/velo" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="56dp"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <!-- El héroe -->
            <LinearLayout
                android:id="@+id/heroe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="40dp"
                android:paddingBottom="26dp">

                <TextView
                    android:id="@+id/heroeTitulo"
                    android:layout_width="620dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texto"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/heroeDatos"
                    android:layout_width="620dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/apagado"
                    android:textSize="16sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/heroeSinopsis"
                    android:layout_width="620dp"
                    android:layout_height="wrap_content"
                    android:textColor="@color/apagado"
                    android:textSize="16sp"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginTop="12dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp">

                    <Button
                        android:id="@+id/heroeVer"
                        android:layout_width="wrap_content"
                        android:layout_height="60dp"
                        android:minWidth="230dp"
                        android:text="Reproducir"
                        android:textColor="@color/texto"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:background="@drawable/boton" />

                    <FrameLayout
                        android:id="@+id/heroeBloqueNota"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:id="@+id/heroeAnillo"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progressDrawable="@drawable/anillo_nota" />

                        <TextView
                            android:id="@+id/heroeNota"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:gravity="center"
                            android:textColor="@color/texto"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Y aquí se cuelgan las filas, una por rótulo -->
            <LinearLayout
                android:id="@+id/filas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/tenue"
                android:textSize="18sp"
                android:padding="40dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- El carril, flotando encima como en las demás pantallas -->
    <include
        android:id="@+id/carril"
        layout="@layout/nav_secciones"
        android:layout_width="70dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <ProgressBar
        android:id="@+id/girando"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="center" />
</FrameLayout>
