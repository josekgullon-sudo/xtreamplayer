<?xml version="1.0" encoding="utf-8"?>
<!--
  Entrar. Usuario y contraseña, y nada más a la vista.

  Antes pedía servidor, usuario y contraseña, los tres al mismo nivel, y eso
  ya es un formulario de instalador: quien ha comprado una lista a alguien no
  sabe cuál es su servidor ni tiene por qué saberlo. A qué servidor va cada
  cliente lo guarda el panel. La lista propia sigue estando, escondida detrás
  de un botón, para quien no tiene proveedor aquí.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="52dp"
            android:paddingBottom="48dp"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <!-- El logotipo es el nombre: «TOTAL» blanco y «player» rojo. El
                 color se pone desde el código, en Marca -->
            <TextView
                android:id="@+id/nombreMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTALplayer"
                android:textColor="@color/texto"
                android:textSize="42sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/aviso"
                android:layout_width="640dp"
                android:layout_height="wrap_content"
                android:text="Entra con el usuario y la contraseña que te dio tu proveedor"
                android:textColor="@color/apagado"
                android:textSize="17sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="20dp" />

            <!--
              Por qué no ha entrado, imposible de pasar por alto.

              El motivo salía en la misma línea gris de la explicación, con
              el mismo tamaño y el mismo color: a tres metros no se ve, y el
              que lo mira solo percibe que ha pulsado «Entrar» y no ha
              pasado nada. Y el motivo importa —«has alcanzado el límite de
              dispositivos» se arregla en un minuto si sabes que es eso—.
            -->
            <TextView
                android:id="@+id/porQueNo"
                android:layout_width="640dp"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:background="@drawable/aviso_malo"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:layout_marginBottom="18dp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/campoUsuario"
                android:layout_width="640dp"
                android:layout_height="66dp"
                android:hint="Usuario"
                android:textColorHint="@color/tenue"
                android:textColor="@color/texto"
                android:textSize="19sp"
                android:background="@drawable/campo"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:inputType="text"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:layout_marginBottom="14dp" />

            <EditText
                android:id="@+id/campoClave"
                android:layout_width="640dp"
                android:layout_height="66dp"
                android:hint="Contraseña"
                android:textColorHint="@color/tenue"
                android:textColor="@color/texto"
                android:textSize="19sp"
                android:background="@drawable/campo"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:importantForAutofill="no"
                android:layout_marginBottom="22dp" />

            <TextView
                android:id="@+id/botonEntrar"
                android:layout_width="640dp"
                android:layout_height="68dp"
                android:text="Entrar"
                android:textColor="@color/texto"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/boton" 
                            android:gravity="center"
                            android:focusable="true"
                            android:clickable="true" />

            <!-- La otra puerta, para quien trae su propia lista. Discreta a
                 propósito: el cliente de un proveedor no debe ni planteárselo -->
            <TextView
                android:id="@+id/botonPropia"
                android:layout_width="640dp"
                android:layout_height="54dp"
                android:text="No tengo cuenta: quiero usar mi lista M3U o Xtream"
                android:textColor="@color/apagado"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:background="@drawable/pastilla"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/bloquePropia"
                android:layout_width="640dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pega la dirección de tu servidor Xtream o el enlace de tu lista M3U. El usuario y la contraseña de arriba son los de esa lista."
                    android:textColor="@color/tenue"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/campoServidor"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:hint="http://servidor.com:8080   ·   o un enlace .m3u"
                    android:textColorHint="@color/tenue"
                    android:textColor="@color/texto"
                    android:textSize="17sp"
                    android:background="@drawable/campo"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:importantForAutofill="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Mientras entra: sin esto, pulsar «Entrar» y que no pase nada durante
         cinco segundos parece que la tele se ha colgado -->
    <LinearLayout
        android:id="@+id/cargando"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#E6201F28"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/marca" />

        <TextView
            android:id="@+id/textoCargando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Entrando…"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:layout_marginTop="18dp" />
    </LinearLayout>
</FrameLayout>
