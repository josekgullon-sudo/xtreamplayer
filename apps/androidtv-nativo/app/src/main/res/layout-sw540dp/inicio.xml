<?xml version="1.0" encoding="utf-8"?>
<!--
  El inicio, con la misma cara que la versión de ordenador.

  Marca arriba a la izquierda y «Salir» a la derecha en fino —es una puerta,
  no un destino—; las pestañas de sección centradas, con la abierta cercada
  en color; y debajo lo que hay: una fila en directo, una de series y una de
  películas.

  Antes era un lanzador: tres tarjetas con el nombre de cada sección y ni un
  solo título a la vista. Encender la tele y que lo primero sea un menú es
  hacer elegir antes de haber visto nada.

  Todo va por pesos y no por alturas fijas: una tele de 1080p da 540 puntos
  de alto y cualquier medida cerrada acaba cortada por el borde.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- La cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="22dp">

        <TextView
            android:id="@+id/marca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TOTALPLAYER"
            android:textColor="@color/texto"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/botonBuscar"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pastilla"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_buscar"
                android:tint="@color/tenue"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Buscar"
                android:textColor="@color/tenue"
                android:textSize="14sp" />
        </LinearLayout>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/botonActualizar"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pastilla"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_recargar"
                android:tint="@color/tenue"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Actualizar"
                android:textColor="@color/tenue"
                android:textSize="14sp" />
        </LinearLayout>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <!-- Ajustes: el idioma, los aparatos de la cuenta y si el que falla
             es el proveedor o esta tele. Ver AjustesActivity -->
        <LinearLayout
            android:id="@+id/botonAjustes"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pastilla"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_ajustes"
                android:tint="@color/tenue"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ajustes"
                android:textColor="@color/tenue"
                android:textSize="14sp" />
        </LinearLayout>

        <Space android:layout_width="10dp" android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/botonSalir"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/pastilla"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_salir"
                android:tint="@color/tenue"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/textoSalir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/tenue"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- El saludo, en voz baja: quién eres se dice una vez y no ocupa media
         pantalla como cuando esto era un menú y no tenía nada más que decir -->
    <TextView
        android:id="@+id/saludo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tenue"
        android:textSize="15sp"
        android:layout_marginTop="10dp" />

    <!--
      Las pestañas, centradas.

      Son el eje de la pantalla: lo primero que se mira al encender y lo que
      contesta a «¿y ahora qué?». Con la abierta cercada, que es como se sabe
      dónde estás sin leer.
    -->
    <LinearLayout
        android:id="@+id/pestanas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="horizontal"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <include
            android:id="@+id/tarjetaDirecto"
            layout="@layout/pieza_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space android:layout_width="14dp" android:layout_height="1dp" />

        <include
            android:id="@+id/tarjetaPelis"
            layout="@layout/pieza_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space android:layout_width="14dp" android:layout_height="1dp" />

        <include
            android:id="@+id/tarjetaSeries"
            layout="@layout/pieza_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Space android:layout_width="14dp" android:layout_height="1dp" />

        <include
            android:id="@+id/tarjetaBajadas"
            layout="@layout/pieza_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!--
      Y debajo, lo que hay.

      Un ScrollView y no una lista reciclada: son tres filas contadas, cada
      una con su propia lista horizontal dentro, y una lista vertical
      reciclando listas horizontales es justo donde el foco de un mando se
      pierde.
    -->
<!--
      Y esto SIN `clipChildren="false"`, que es lo que hacía que al bajar se
      viera todo junto.

      Un ScrollView con los hijos sin recortar no recorta su contenido a su
      propio hueco: las filas se pintan fuera, encima del menú, de la
      cabecera y de la versión, y la pantalla pasa a ser un amasijo en el que
      no se distingue dónde acaba una cosa y empieza otra. El
      `clipToPadding` sí se queda —es para que la última fila respire por
      abajo— y lo de no recortar, donde de verdad hace falta: en las filas de
      dentro, para que el aro del foco de una carátula no salga cortado.
    -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/filas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="26dp" />
    </ScrollView>

    <!--
      La versión, a la vista y en voz baja.
    
      Esta aplicación no se actualiza sola: es un APK que hay que
      reinstalar, al revés que la web. Sin el número en pantalla no hay
      forma de saber si lo que se mira es lo último o lo del mes pasado
      —ni para quien la usa ni para quien la arregla—, que es justo el
      rato que se pierde discutiendo una foto.
    -->
    <TextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tenue"
        android:textSize="12sp"
        android:alpha="0.7"
        android:paddingBottom="6dp" />

    <TextView
        android:id="@+id/aviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/tenue"
        android:textSize="14sp"
        android:paddingBottom="10dp"
        android:visibility="gone" />
</LinearLayout>
