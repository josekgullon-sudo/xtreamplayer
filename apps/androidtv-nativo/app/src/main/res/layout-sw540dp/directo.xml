<?xml version="1.0" encoding="utf-8"?>
<!--
  TV en directo: carpetas, canales y lo que se está viendo.

  El vídeo va a la derecha y pequeño a propósito: lo que se hace aquí es
  buscar canal, y para eso hay que ver la lista. Cuando ya se ha elegido, con
  otro OK se va a pantalla completa, que es donde se ve la tele.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

  <!--
    El contenido, dejándole al carril solo el hueco de sus iconos.

    El carril flota por encima (abajo del todo) en vez de ser una columna
    más: como columna se llevaba 70 puntos enteros de los 960 de una tele, y
    esos 70 salían del vídeo, que es lo que se ha venido a ver. Así solo
    ocupa de verdad los 56 del hueco, y cuando tiene el foco se dibuja
    encima de la lista sin empujar nada.
  -->
  <LinearLayout
    android:id="@+id/filaDirecto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingTop="64dp">


    <!-- Canales -->
    <LinearLayout
        android:id="@+id/columnaCanales"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/columna"
        android:paddingTop="26dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tituloCarpeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- .pa-live-n: cuántos hay dentro, sin tener que bajar a contarlos -->
            <TextView
                android:id="@+id/cuantos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/contador"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/tenue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCanales"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />

        <!--
          Cuando algo falla, una salida.

          Se quedó la pantalla entera en blanco —sin carpetas, sin canales y
          sin nada que pulsar— porque el servidor del proveedor dejó de
          contestar un momento. Sin un botón para reintentar, la única salida
          era cerrar la aplicación.
        -->
        <LinearLayout
            android:id="@+id/bloqueVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esta carpeta no tiene canales."
                android:textColor="@color/apagado"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/botonReintentar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pastilla"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_recargar"
                    android:tint="@color/texto"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Volver a cargar"
                    android:textColor="@color/texto"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Lo que se ve -->
    <LinearLayout
        android:id="@+id/columnaVideo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- La caja del vídeo se ajusta a 16:9 desde el código: dejándola
             estirarse, el vídeo salía con dos franjas negras enormes -->
        <FrameLayout
            android:id="@+id/caja"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/vista"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/pista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Elige un canal de la lista"
                android:textColor="@color/tenue"
                android:textSize="17sp"
                android:padding="20dp" />

            <ProgressBar
                android:id="@+id/girando"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:indeterminateDrawable="@drawable/girando"
                android:indeterminateDuration="800"
                android:visibility="gone" />
        </FrameLayout>

        <!--
          Todo lo que se esconde al pasar a pantalla completa.

          Y lo que sobra en la columna se lo queda ESTO, no la tira de
          carpetas. Debajo del vídeo van tres cosas: lo que se está viendo,
          la pista de cómo ampliar y la tira de carpetas. Con las tres a
          `wrap_content`, el bloque de en medio crece con la guía —lo de
          ahora, lo de luego, cinco o seis renglones— y empuja la tira fuera
          de la pantalla por abajo. Desde el sofá eso no se lee como «se ha
          salido»: se lee como que la aplicación no tiene carpetas, y sin
          ellas no hay manera de llegar a los otros ocho mil canales.

          Dándole el hueco sobrante a este bloque, la tira se queda siempre a
          la vista y lo que se recorta, si algo se recorta, es el último
          renglón de la guía. Que es lo que se puede perder.
        -->
        <LinearLayout
            android:id="@+id/bloqueInfo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Qué se está viendo -->
            <TextView
                android:id="@+id/nombreCanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/etiquetaAhora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AHORA"
                android:textColor="@color/marca_viva"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ahora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/etiquetaLuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESPUÉS"
                android:textColor="@color/tenue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <!--
                La parrilla, no un solo título. Y ojo: esta variante es la
                que usa cualquier televisor. Cambiar solo la de `layout/`
                deja aquí un identificador que ya no existe, `findViewById`
                devuelve null y la pantalla se cae al abrir un canal — sin
                que la compilación diga nada, porque el identificador sí
                existe en la otra variante.
            -->
            <LinearLayout
                android:id="@+id/luegoLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/comoAmpliar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OK otra vez para pantalla completa · Mantén OK para marcar como favorito"
            android:textColor="@color/tenue"
            android:textSize="14sp"
            android:visibility="gone" />

        <!--
          Y las carpetas, en fila y al final.

          Estuvieron en una columna propia a la izquierda, 256 puntos de los
          960 de una tele para enseñar una lista de nombres. Esos 256 salían
          del vídeo, que es lo que se ha venido a ver. En fila ocupan el alto
          de una pastilla, se recorren de lado con el mando y dejan la
          pantalla entera para el canal. Es lo mismo que hace la versión de
          ordenador y por el mismo motivo.
        -->
        <LinearLayout
            android:id="@+id/columnaCarpetas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:clipChildren="false">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CARPETAS"
                android:textColor="@color/tenue"
                android:textSize="13sp"
                android:letterSpacing="0.14"
                android:layout_marginTop="16dp"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaCarpetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:clipChildren="false" />
        </LinearLayout>
    </LinearLayout>
  </LinearLayout>

  <!-- Y el carril, encima de todo y pegado a la izquierda -->
  <include
      android:id="@+id/carril"
      layout="@layout/nav_secciones"
      android:layout_width="match_parent"
      android:layout_height="64dp"
      android:layout_gravity="top" />
</FrameLayout>
