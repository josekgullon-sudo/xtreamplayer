<?xml version="1.0" encoding="utf-8"?>
<!--
  TV en directo: carpetas, canales y lo que se está viendo.

  El vídeo va a la derecha y pequeño a propósito: lo que se hace aquí es
  buscar canal, y para eso hay que ver la lista. Cuando ya se ha elegido, con
  otro OK se va a pantalla completa, que es donde se ve la tele.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/fondo">

    <!-- El carril de secciones: pasar de películas a series sin volver al
         menú. Va el primero para que ◀ desde la primera columna caiga aquí -->
    <include
        android:id="@+id/carril"
        layout="@layout/nav_secciones"
        android:layout_width="70dp"
        android:layout_height="match_parent" />

    <!-- Carpetas -->
    <LinearLayout
        android:id="@+id/columnaCarpetas"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/superficie"
        android:paddingTop="26dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TV EN DIRECTO"
            android:textColor="@color/tenue"
            android:textSize="13sp"
            android:letterSpacing="0.14"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCarpetas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <!-- Canales -->
    <LinearLayout
        android:id="@+id/columnaCanales"
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/columna"
        android:paddingTop="26dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tituloCarpeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/texto"
                android:textSize="19sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <!-- .pa-live-n: cuántos hay dentro, sin tener que bajar a contarlos -->
            <TextView
                android:id="@+id/cuantos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/contador"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/tenue"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCanales"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />

        <!--
          Cuando algo falla, una salida.

          Se quedó la pantalla entera en blanco —sin carpetas, sin canales y
          sin nada que pulsar— porque el servidor del proveedor dejó de
          contestar un momento. Sin un botón para reintentar, la única salida
          era cerrar la aplicación.
        -->
        <LinearLayout
            android:id="@+id/bloqueVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="18dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esta carpeta no tiene canales."
                android:textColor="@color/apagado"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/botonReintentar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pastilla"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_recargar"
                    android:tint="@color/texto"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Volver a cargar"
                    android:textColor="@color/texto"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Lo que se ve -->
    <LinearLayout
        android:id="@+id/columnaVideo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- La caja del vídeo se ajusta a 16:9 desde el código: dejándola
             estirarse, el vídeo salía con dos franjas negras enormes -->
        <FrameLayout
            android:id="@+id/caja"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:background="#000000">

            <androidx.media3.ui.PlayerView
                android:id="@+id/vista"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/pista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Elige un canal de la lista"
                android:textColor="@color/tenue"
                android:textSize="17sp"
                android:padding="20dp" />

            <ProgressBar
                android:id="@+id/girando"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/marca"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Todo lo que se esconde al pasar a pantalla completa -->
        <LinearLayout
            android:id="@+id/bloqueInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Qué se está viendo -->
            <TextView
                android:id="@+id/nombreCanal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="24sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/etiquetaAhora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AHORA"
                android:textColor="@color/marca_viva"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/ahora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="18sp"
                android:maxLines="3"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/etiquetaLuego"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESPUÉS"
                android:textColor="@color/tenue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/luego"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/apagado"
                android:textSize="16sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/comoAmpliar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OK otra vez para pantalla completa · Mantén OK para marcar como favorito"
            android:textColor="@color/tenue"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
