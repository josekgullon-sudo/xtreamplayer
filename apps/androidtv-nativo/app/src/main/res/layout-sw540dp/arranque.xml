<?xml version="1.0" encoding="utf-8"?>
<!--
  Lo primero que se ve al encender.

  El nombre es el logotipo: «TOTAL» en blanco y «player» en rojo, sobre
  negro. Antes había delante un cuadrado rojo con un triángulo blanco, que
  es literalmente el de YouTube, y el nombre quedaba de acompañante. Ahora
  entra el nombre con su resplandor detrás, se abre la línea de la marca y
  suena el acorde. Dura tres segundos y pico y se salta con cualquier tecla.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_arranque">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:clipChildren="false">

        <!-- El nombre, con el resplandor por detrás -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false">

            <View
                android:id="@+id/halo"
                android:layout_width="620dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:background="@drawable/halo_marca" />

            <TextView
                android:id="@+id/nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="TOTALplayer"
                android:textColor="@color/texto"
                android:textSize="66sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:letterSpacing="-0.02" />
        </FrameLayout>

        <View
            android:id="@+id/linea"
            android:layout_width="380dp"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/linea_marca"
            android:scaleX="0" />

        <TextView
            android:id="@+id/lema"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Tu televisión, donde quieras"
            android:textColor="@color/tenue"
            android:textSize="18sp"
            android:letterSpacing="0.10"
            android:alpha="0" />
    </LinearLayout>
</FrameLayout>
