<?xml version="1.0" encoding="utf-8"?>
<!--
  La ficha: cartel, de qué va y el botón de ver.

  Si es una serie, debajo salen las temporadas y sus episodios. Antes no
  había ficha de ninguna clase: se pulsaba y o arrancaba o no, sin saber
  siquiera de qué año era.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo">

    <!--
      La carátula, muy apagada, ocupando el fondo entero.

      Es lo que distingue una ficha de un formulario: el título llena la
      pantalla en vez de dejar dos tercios de gris vacío. Va al 16% y con un
      velo encima para que el texto siga leyéndose desde el sofá.
    -->
    <ImageView
        android:id="@+id/fondo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.16"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/velo_ficha" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="56dp"
            android:paddingEnd="56dp"
            android:paddingTop="44dp"
            android:paddingBottom="44dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cartel"
                    android:layout_width="230dp"
                    android:layout_height="345dp"
                    android:scaleType="centerCrop"
                    android:background="@color/superficie"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="34dp">

                    <TextView
                        android:id="@+id/titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/texto"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />


                    <!--
                      Los datos, cada uno en su chip.

                      Antes era una sola línea con todo pegado por puntos:
                      «2022 · Sci-Fi & Fantasy, Drama · 60 min». Se leía como
                      un pie de foto y no como lo que es —cinco datos
                      distintos—, y el que más se busca, la nota, quedaba
                      escondido en medio. Los que el proveedor no manda no se
                      pintan, en vez de dejar el hueco o un cero.
                    -->
                    <LinearLayout
                        android:id="@+id/chips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:id="@+id/chipNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/chip_ficha"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/texto"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipAnio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/chip_ficha"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/texto"
                            android:textSize="15sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipTemporadas"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/chip_ficha"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/texto"
                            android:textSize="15sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipEdad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/chip_ficha"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/texto"
                            android:textSize="15sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipDuracion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/chip_ficha"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:textColor="@color/texto"
                            android:textSize="15sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipCalidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/chip_calidad"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/apagado"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/datos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="16sp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/sinopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="17sp"
                        android:lineSpacingExtra="6dp"
                        android:maxLines="7"
                        android:ellipsize="end"
                        android:layout_marginTop="18dp" />


                    <!--
                         El reparto con la cara de cada uno, cuando se sabe.

                         Nace escondido: solo hay caras si nuestro servidor reconoce el título.
                         Cuando no las hay se queda el «Elenco» de siempre, que son los nombres
                         que manda el panel en una línea.
                    -->
                    <TextView
                        android:id="@+id/rotuloReparto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reparto"
                        android:textColor="@color/marca_viva"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="18dp"
                        android:visibility="gone" />

                    <HorizontalScrollView
                        android:id="@+id/bloqueReparto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:clipToPadding="false"
                        android:layout_marginTop="10dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/filaReparto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <!-- Elenco y géneros, con su etiqueta en color: son dos
                         listas de nombres y sin rótulo se leen como una -->
                    <TextView
                        android:id="@+id/rotuloElenco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Elenco"
                        android:textColor="@color/marca_viva"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="18dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/elenco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="16sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/rotuloGeneros"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Géneros"
                        android:textColor="@color/marca_viva"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:layout_marginTop="14dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/generos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/apagado"
                        android:textSize="16sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="4dp"
                        android:visibility="gone" />

                    <!-- Reproducir, el corazón aparte y el círculo de la
                         nota, como en la referencia -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top"
                        android:layout_marginTop="24dp">

                        <!--
                             Un TextView y no un Button, y no es capricho.

                             Un Button hereda el estilo del tema, y el tema de
                             un televisor no siempre es el que uno cree: en Fire
                             OS el fabricante pone el suyo y ese estilo pisa el
                             fondo, así que la pastilla roja salía blanca con la
                             letra oscura justo al enfocarla. Un TextView no
                             tiene estilo que heredar: lo que se pinta es lo que
                             pone aquí, en cualquier aparato.
                        -->
                        <TextView
                            android:id="@+id/botonVer"
                            android:layout_width="wrap_content"
                            android:layout_height="62dp"
                            android:minWidth="240dp"
                            android:text="Ver ahora"
                            android:textColor="@color/texto"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textAllCaps="false"
                            android:background="@drawable/boton" 
                            android:gravity="center"
                            android:focusable="true"
                            android:clickable="true" />

                        <!--
                             El icono, con su palabra debajo.

                             Un icono suelto hay que probarlo para saber qué hace, y un corazón
                             lo mismo es «me gusta» que «guardar» que «seguir». En el ordenador
                             el rótulo va al lado; aquí debajo, que es donde cabe sin empujar
                             «Ver ahora» fuera de la fila.

                             La columna no coge el foco: lo sigue cogiendo el icono, que es lo
                             que el código conoce por su identificador.
                        -->
                        <LinearLayout
                            android:id="@+id/bloqueFavorito"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginStart="14dp"
                            android:paddingTop="2dp"
                            android:focusable="false">

                            <ImageView
                                android:id="@+id/botonFavorito"
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:padding="16dp"
                                android:background="@drawable/circulo_accion"
                                android:src="@drawable/ic_corazon"
                                android:tint="@color/apagado"
                                android:focusable="true"
                                android:clickable="true"
                                android:contentDescription="Favorito" />

                            <TextView
                                android:id="@+id/etiquetaFavorito"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Mi lista"
                                android:textColor="@color/apagado"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <!--
                             Guardarlo en el aparato, al lado de reproducirlo y de marcarlo.
                             Nace escondido: solo aparece cuando la ficha es de algo que se puede
                             bajar —una película o un episodio— y hay hueco donde guardarlo.
                        -->
                        <LinearLayout
                            android:id="@+id/bloqueBajar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:layout_marginStart="14dp"
                            android:paddingTop="2dp"
                            android:visibility="gone"
                            android:focusable="false">

                            <ImageView
                                android:id="@+id/botonBajar"
                                android:layout_width="58dp"
                                android:layout_height="58dp"
                                android:padding="16dp"
                                android:background="@drawable/circulo_accion"
                                android:src="@drawable/ic_bajar"
                                android:tint="@color/apagado"
                                android:focusable="true"
                                android:clickable="true"
                                android:contentDescription="Descargar" />

                            <TextView
                                android:id="@+id/etiquetaBajar"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="Descargar"
                                android:textColor="@color/apagado"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <FrameLayout
                            android:id="@+id/bloqueNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/anilloNota"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="62dp"
                                android:layout_height="62dp"
                                android:indeterminate="false"
                                android:max="100"
                                android:progressDrawable="@drawable/anillo_nota" />

                            <TextView
                                android:id="@+id/textoNota"
                                android:layout_width="62dp"
                                android:layout_height="62dp"
                                android:gravity="center"
                                android:textColor="@color/texto"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/pieNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:paddingTop="11dp"
                            android:text="Calificación de\nlos usuarios"
                            android:textColor="@color/apagado"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Solo en series -->
            <LinearLayout
                android:id="@+id/bloqueSerie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="36dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/temporadas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/episodios"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="18dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/girando"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/marca"
        android:visibility="gone" />
</FrameLayout>
