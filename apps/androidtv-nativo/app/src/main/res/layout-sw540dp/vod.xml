<?xml version="1.0" encoding="utf-8"?>
<!--
  Películas y series: la misma pantalla para las dos, porque se usan igual.
  Carpetas a la izquierda y carteles a la derecha: la carátula es lo que hace
  que alguien elija, y en una lista de texto no elige nadie.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@color/fondo">

    <!-- El carril de secciones: pasar de películas a series sin volver al
         menú. Va el primero para que ◀ desde la primera columna caiga aquí -->
    <include
        android:id="@+id/carril"
        layout="@layout/nav_secciones"
        android:layout_width="70dp"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/columnaCarpetas"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/superficie"
        android:paddingTop="26dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tituloSeccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tenue"
            android:textSize="13sp"
            android:letterSpacing="0.14"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="14dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaCarpetas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/columnaRejilla"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/tituloCarpeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/texto"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Cuántos títulos hay: en una rejilla que se carga a
                     trozos, no hay otra manera de saberlo -->
                <TextView
                    android:id="@+id/cuantos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/contador"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/tenue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rejilla"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:paddingBottom="20dp"
                android:clipToPadding="false"
                android:clipChildren="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bloqueVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/vacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/apagado"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp" />

            <LinearLayout
                android:id="@+id/botonReintentar"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/pastilla"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingEnd="24dp"
                android:layout_marginTop="18dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_recargar"
                    android:tint="@color/texto"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Volver a cargar"
                    android:textColor="@color/texto"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/girando"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/marca"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
