{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TOTALplayer",
  "version": "1.0.0",
  "identifier": "app.totalplayer.escritorio",
  "build": {
    "frontendDist": "../interfaz"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "TOTALplayer",
    "shortDescription": "TOTALplayer",
    "longDescription": "El reproductor de TOTALplayer para Windows: la misma aplicación que en el televisor, a pantalla completa.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"]
      }
    }
  }
}
